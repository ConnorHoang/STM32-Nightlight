import matplotlib.pyplot as plt

# Ambient room light conditions from darkest to brightest
conditions = [
    'Full Dark',
    'Fully Closed\nBlinds',
    'Mostly Closed\nBlinds',
    'Cloudy Partial\nBlinds',
    'Partial Closed\nBlinds',
    'Full Daylight'
]
r_ambient_kohm = [13210.0, 1300.0, 32.27, 18.0, 11.78, 0.06]

plt.figure(figsize=(8, 5))

# Plot resistance vs. light level on a logarithmic scale
plt.plot(conditions, r_ambient_kohm, 'ro-', linewidth=2, markersize=8)
plt.yscale('log')

plt.title('Ambient Room Light vs. Resistance')
plt.xlabel('Light Level')
plt.ylabel('Resistance (kOhms)')
plt.grid(True, linestyle='--', alpha=0.7)
plt.xticks(rotation=45)

plt.tight_layout()
plt.savefig('ambient_characterization_mvp.png')
plt.show()